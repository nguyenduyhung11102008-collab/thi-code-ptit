#include <stdio.h>


int min(int a, int b) {
    return (a < b) ? a : b;
}


int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int x1, y1, x2, y2;
    int x3, y3, x4, y4;
    
    
    if (scanf("%d %d %d %d", &x1, &y1, &x2, &y2) != 4) return 0;
    if (scanf("%d %d %d %d", &x3, &y3, &x4, &y4) != 4) return 0;
    
    
    int min_x = min(x1, x3);
    int max_x = max(x2, x4);
    int min_y = min(y1, y3);
    int max_y = max(y2, y4);
    
    
    int width = max_x - min_x;
    int height = max_y - min_y;
    
    
    int edge = max(width, height);
    
    
    printf("%d\n", edge * edge);
    
    return 0;
}
